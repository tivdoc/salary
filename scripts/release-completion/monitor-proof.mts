import '../production-refusal.mjs';
import assert from 'node:assert/strict';import {readFileSync,writeFileSync} from 'node:fs';import {randomUUID,createHash} from 'node:crypto';import pg from 'pg';import {readDevEnvFile} from '../supabase-dev-guard/dev-credential.mts';import {TIVDOC_DEV_PROJECT_REF} from '../supabase-dev-guard/guard.mts';import {summarizeMonitor} from '../../src/server/product/reports/monitor.ts';
const env=readDevEnvFile();assert.equal(env.get('TIVDOC_DEV_PROJECT_REF'),TIVDOC_DEV_PROJECT_REF);function client(key:string){const u=new URL(env.get(key)!);u.pathname='/tivdoc_release_replay_20260907';return new pg.Client({connectionString:u.toString()});}const db=client('TIVDOC_DEV_DATABASE_URL'),ops=client('TIVDOC_OPERATIONS_POSTGRES_URL'),web=client('TIVDOC_WEB_POSTGRES_URL');await Promise.all([db.connect(),ops.connect(),web.connect()]);const id=randomUUID(),delivery=createHash('sha256').update(id).digest('hex'),checks:string[]=[];const pass=(s:string)=>{checks.push(s);console.log('PASS '+s);};
try{if(!(await db.query("select to_regprocedure('public.case_funnel_monitor()') value")).rows[0].value)await db.query(readFileSync('supabase/migrations/20260907141000_product_monitor.sql','utf8'));const read=async()=>summarizeMonitor((await ops.query('select public.case_funnel_monitor() value')).rows[0].value,{notifications:false});const before=await read();await assert.rejects(web.query('select public.case_funnel_monitor()'),/permission denied/);pass('monitor requires the operations database role');
 await db.query("insert into public.cases(id,first_name,email,phone,status,payment_status,check_period_month,is_qa) values($1,'Synthetic monitor','synthetic@example.invalid','0500000000','started','not_started','2026-06-01',true)",[id]);
 await db.query("insert into private.case_notification_outbox(delivery_id,case_id,recipient_sha256,template,state,expires_at,created_at,last_error) values($1,$2,$1,'synthetic','dead_letter',now()-interval '1 hour',now()-interval '2 hours','synthetic_provider_failure')",[delivery,id]);const after=await read();assert.equal(after.alerts.find(a=>a.code==='notification_dead_letter')!.count,before.alerts.find(a=>a.code==='notification_dead_letter')!.count+1);assert.ok(after.alerts.find(a=>a.code==='notification_dead_letter')!.recovery.includes('suppression'));pass('injected provider failure appears with age and a specific recovery instruction');assert.ok(!JSON.stringify(after).includes('synthetic@example.invalid'));assert.ok(!JSON.stringify(after).includes(delivery));assert.equal(after.storageIntegrity,'not_measured');pass('monitor excludes PII and never claims unmeasured Storage integrity');
 writeFileSync('docs/release-evidence/P12-monitor-db.json',JSON.stringify({checks,database:'tivdoc_release_replay_20260907',fixtures:'synthetic QA; injected dead letter',providerVerified:false,browserProven:false,production:'untouched'},null,2)+'\n');
}finally{await db.query("delete from public.cases where id=$1 and first_name='Synthetic monitor'",[id]);await Promise.all([db.end(),ops.end(),web.end()]);}
