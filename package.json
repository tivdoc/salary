{
  "name": "tivdoc-salary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:payslip": "vitest run src/engine/extraction/benchmark.test.ts --reporter=verbose",
    "benchmark:payslip:openai": "vitest run --config vitest.openai.config.mts --reporter=verbose",
    "benchmark:payslip:openai:real": "vitest run --config vitest.openai.real.config.mts --reporter=verbose",
    "benchmark:payslip:openai:real:v2": "vitest run --config vitest.openai.real.config.mts src/server/engine/extraction/benchmarks/openai/real-public/openai-real-v2-benchmark.external.test.ts --reporter=verbose",
    "benchmark:payslip:openai:real:v2.1": "vitest run --config vitest.openai.real.config.mts src/server/engine/extraction/benchmarks/openai/real-public/openai-real-v21-benchmark.external.test.ts --reporter=verbose",
    "cases:report": "node scripts/cases-report.mjs",
    "funnel:report": "node scripts/funnel-report.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.2",
    "openai": "7.8.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
